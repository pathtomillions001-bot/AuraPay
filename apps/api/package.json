{
  "name": "@aurapay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production node dist/main.js",
    "seed": "tsx src/seed/run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "MODE=sandbox SQLITE_PATH=.data/smoke.sqlite tsx scripts/smoke.ts",
    "check:sql": "python3 ../../tools/check-sql-inserts.py",
    "verify:ledger": "MODE=sandbox tsx scripts/verify-ledger.ts"
  },
  "dependencies": {
    "@aurapay/shared": "*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "qrcode": "^1.5.4",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/qrcode": "^1.5.5"
  }
}
